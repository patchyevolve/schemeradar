# SchemeRadar — local environment template
# BUILD_ORDER Step 1 task 1.4
#
#   cp .env.example .env
#
# None of these are architectural constants (ARCHITECTURE §9) — they are local
# configuration only. Never commit `.env` (it is git-ignored).

# ---------------------------------------------------------------- datastores
MONGO_URI=mongodb://localhost:27017
MONGO_DB=schemeradar
MONGO_PORT=27017

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=schemes
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------- object storage (verification
# snapshots at snapshots/{scheme_id}/{job_id}.png, 90-day lifecycle)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=schemeradar
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=schemeradar-snapshots
OBJECT_STORAGE_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------ TinyFish
# 3-tier integration (ARCHITECTURE §7) — all three read the same key but are
# configured independently so one tier can be disabled in isolation.
TINYFISH_API_KEY=
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT_TIER1_MS=2000
TINYFISH_TIMEOUT_TIER2_MS=8000
TINYFISH_TIMEOUT_TIER3_MS=4000
TINYFISH_BROWSER_CONCURRENCY=3
TINYFISH_TOP_N_VERIFIED=5

# ----------------------------------------------------------------- LLM tier
# Semantic Auditor (lambda_llm) + LLM Structured Schema Parser (ingestion).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_AUDIT_TIMEOUT_MS=900

# ------------------------------------------------------------- security/auth
# Required for POST /api/v1/admin/ingest/refresh
ADMIN_SERVICE_TOKEN=

# --------------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
